{
  "name": "tarka-monorepo",
  "private": true,
  "description": "Tarka platform — workspace root for frontend and packages",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w tarka-ui",
    "build": "npm run build -w tarka-ui",
    "lint": "npm run lint -w tarka-ui",
    "test": "npm run test -w tarka-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "postcss": "8.5.23",
    "@babel/core": "7.29.6",
    "monaco-editor": {
      "dompurify": "3.4.12"
    },
    "jspdf": {
      "dompurify": "3.4.12"
    }
  }
}
