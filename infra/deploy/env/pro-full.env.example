# Pro tier — full stack (docker compose --profile full)
# From infra/deploy/: cp env/pro-full.env.example .env && docker compose --profile full up -d
#
# Mirrors infra/deploy/.env.example; kept here for tiered copy-paste alongside community.

FEATURE_SERVICE_URL=http://signal-api:8004/features
ML_SCORING_URL=http://signal-api:8004/ml
GRAPH_SERVICE_URL=http://graph-service:8001
# Fraud spine — evaluate fail-closed / CQRS lag (pair with production-hardening overlay)
FEATURE_CATALOG_FAIL_CLOSED_EVENT_TYPES=payment
GRAPH_RISK_FRESHNESS_DEFAULT_POLICY=warn
GRAPH_RISK_FRESHNESS_POLICY_BY_EVENT=payment:fail_closed,login:skip
ASYNC_ENRICH_MAX_AGE_MINUTES=60
# Integrity baseline (pair with docker-compose.production-hardening.yml)
INTEGRITY_SOFT_TAGS=true
REPLAY_PAYLOAD_TTL_SECONDS=300
# REQUEST_SIGNATURE_SECRET=
