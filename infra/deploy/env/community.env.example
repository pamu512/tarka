# Community tier — use with: docker compose -f infra/deploy/docker-compose.lite.yml
# Copy to .env beside the compose file or: docker compose --env-file infra/deploy/env/community.env.example ...
#
# Lite compose already sets GRAPH_SERVICE_URL / ML / OPA empty on services.
# Override only if you extend the stack.

# Optional: override DATABASE_URL / REDIS_URL if Postgres or Redis run outside compose.

# Auto-create a case when evaluate returns deny or review.
# CASE_API_URL is the case-api base URL (core-api loopback in lite compose).
# CASE_INTERNAL_TOKEN is a shared secret for the S2S call so the internal POST
# authenticates as analyst without setting API_KEYS (which would break viewer UI).
# CASE_CREATE_ON_DENY_REVIEW=true
# CASE_API_URL=http://127.0.0.1:8000/cases
# CASE_INTERNAL_TOKEN=change-me-to-a-random-secret

# Auth on the local desk. Default (both unset) = open desk: anonymous requests
# get viewer role, which reads fine but cannot author packs, promote, or open cases.
# ALLOW_INSECURE_NO_AUTH=true
# API_KEYS=change-me-to-a-random-key
# Set BOTH to make curl and the UI work on one box: services require the key for
# REST while the frontend bakes it in at build time. With multiple comma-separated
# API_KEYS, also set VITE_API_KEY to the single key the browser should use.
# VITE_API_KEY=change-me-to-a-random-key

# Internal secret orchestrator requires on /v1/internal/* (ingest side-effect
# commit, label DLQ). If left empty, every consumer side-effect commit 503s and
# the async-ingest plane livelocks — set a real secret whenever the ingest
# profile runs. (Lite desk instead sets ALLOW_INSECURE_NO_AUTH=true.)
# ORCHESTRATOR_INTERNAL_SECRET=change-me-to-a-random-secret

# Host port remaps (defaults in parentheses) — use when your machine already runs
# Postgres/Redis/etc. on the default port. `make doctor` explains conflicts.
# TARKA_PG_PORT=5432
# TARKA_REDIS_PORT=6379
# TARKA_CORE_PORT=8000
# TARKA_FRONTEND_PORT=3000
# TARKA_NATS_PORT=4222
