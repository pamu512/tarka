# Community tier — use with: docker compose -f infra/deploy/docker-compose.lite.yml
# Copy to .env beside the compose file or: docker compose --env-file infra/deploy/env/community.env.example ...
#
# 15-minute first decision: docs/docs/guides/oss-15-minute-first-decision.md
#   python3 scripts/oss/first_decision_smoke.py
#
# Lite compose already sets GRAPH_SERVICE_URL / ML / OPA empty on services.
# Override only if you extend the stack.

# Local try-it only — uncomment for OSS 15-minute path (never production/staging):
# ALLOW_INSECURE_NO_AUTH=true

# Optional: override DATABASE_URL / REDIS_URL if Postgres or Redis run outside compose.
