{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tarka.desk_provision/v1",
  "title": "Tarka desk provision",
  "type": "object",
  "required": ["schema_id"],
  "additionalProperties": false,
  "$defs": {
    "labelHorizonWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730,
          "description": "EXAMPLE tenant policy window in days. Not Tarka morals. Not a chargeback-guarantee SKU."
        }
      }
    }
  },
  "properties": {
    "schema_id": {
      "const": "tarka.desk_provision/v1"
    },
    "profile": {
      "type": "string",
      "enum": ["demo", "product", "brochure"]
    },
    "hunt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Loader Hunt-off. Desk chrome matches only after bake: empty VITE_GRAPH_SERVICE_URL or VITE_HUNT_ENABLED=0 (TARKA_HUNT_ENABLED=0)."
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_url": { "type": "string", "default": "" }
      }
    },
    "leftover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flag_mints_leftover": { "type": "boolean", "default": false },
        "multi_analyst_claim": { "type": "boolean", "default": false },
        "qa_queue_isolates": { "type": "boolean", "default": false },
        "receipt_brief_enabled": { "type": "boolean", "default": false }
      }
    },
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_promote": { "type": "boolean", "default": false }
      }
    },
    "shadow_agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_when_llm_url": { "type": "boolean", "default": true }
      }
    },
    "label_horizons": {
      "type": "object",
      "additionalProperties": false,
      "description": "EXAMPLE tenant policy windows per label_kind. Not Tarka morals. Not a chargeback-guarantee SKU. Never auto-demote from these.",
      "properties": {
        "fp": { "$ref": "#/$defs/labelHorizonWindow" },
        "fraud": { "$ref": "#/$defs/labelHorizonWindow" },
        "other": { "$ref": "#/$defs/labelHorizonWindow" },
        "promo_abuse": { "$ref": "#/$defs/labelHorizonWindow" },
        "collusion": { "$ref": "#/$defs/labelHorizonWindow" },
        "chargeback": { "$ref": "#/$defs/labelHorizonWindow" }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "default": "" },
            "secret_env": { "type": "string", "default": "TARKA_ENFORCEMENT_WEBHOOK_SECRET" }
          }
        },
        "observe_notify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "default": "" },
            "secret_env": { "type": "string", "default": "TARKA_OBSERVE_NOTIFY_WEBHOOK_SECRET" }
          }
        }
      }
    }
  }
}
